// Windows version-info resource for the .asi.
// Configured by CMake (@ONLY): @VAR@ placeholders are filled from project(VERSION).
#include <winver.h>

#define VER_NUM     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#define VER_STR     "@PROJECT_VERSION@.0\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_NUM
 PRODUCTVERSION VER_NUM
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"  // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "007 First Light Ultrawide Patch\0"
            VALUE "FileDescription",  "007 First Light Ultrawide Cutscene Patch (ASI)\0"
            VALUE "FileVersion",      VER_STR
            VALUE "InternalName",     "007FirstLightUltrawide.asi\0"
            VALUE "OriginalFilename", "007FirstLightUltrawide.asi\0"
            VALUE "ProductName",      "007FirstLightUltrawide\0"
            VALUE "ProductVersion",   VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
